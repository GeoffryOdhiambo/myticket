# Never let secrets or local-only state end up baked into an image layer.
.env
.env.*
!.env.example

.git
.gitignore
.github

node_modules
vendor

public/hot
public/storage
public/build

storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/framework/testing/*
storage/logs/*
storage/app/public/*
!storage/**/.gitignore

bootstrap/cache/*.php

docker/scripts
docs

tests
.phpunit.cache
.phpunit.result.cache

.editorconfig
.claude
